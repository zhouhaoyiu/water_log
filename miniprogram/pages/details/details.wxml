<!--pages/details/details.wxml-->
<scroll-view class="page">
    <t-cell-group theme="card">
        <t-cell title="设备ID" note="{{deviceid}}" hover />
        <t-cell title="设备名称" note="{{deviceName}}" hover />
        <t-cell title="设备地址" note="{{deviceLocation}}" hover />
        <t-cell title="设备电压" note="{{deviceVoltage}}" hover />
    </t-cell-group>
    <view wx:for="{{infoArr}}" wx:key="index" style="margin-top: 10px;">
        <t-cell-group theme="card" bindtap="ackNew" data-logid="{{item.logId}}">
            <t-cell title="报警时间" note="{{item.logTime}}"></t-cell>
            <t-cell title="是否已读" note="{{item.new}}"></t-cell>
        </t-cell-group>
    </view>
</scroll-view>